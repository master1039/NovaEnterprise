# Runtime and persistence settings. Copy this file to .env for local overrides.
# Never commit real credentials or secrets.
NOVA_APP_NAME=NovaEnterprise
NOVA_APP_ENV=local
NOVA_DEBUG=false
NOVA_LOG_LEVEL=INFO
NOVA_API_PREFIX=/api/v1
NOVA_DATABASE_URL=sqlite:///./data/enterprise.db
NOVA_DEFAULT_TENANT_ID=novaenterprise-demo
# Local demo only. Replace with a strong secret outside local/test environments.
NOVA_JWT_SECRET=local-demo-secret-change-before-production-32
NOVA_JWT_ISSUER=novaenterprise
NOVA_JWT_AUDIENCE=novaenterprise-api
NOVA_JWT_TTL_MINUTES=60
NOVA_RATE_LIMIT_PER_MINUTE=120
NOVA_AUDIT_TRAIL_MAX_RECORDS=10000
