# Runtime and persistence settings. Copy this file to .env for local overrides.
# Never commit real credentials or secrets.
NOVA_APP_NAME=NovaEnterprise
NOVA_APP_ENV=local
NOVA_DEBUG=false
NOVA_LOG_LEVEL=INFO
NOVA_API_PREFIX=/api/v1
NOVA_DATABASE_URL=sqlite:///./data/enterprise.db
NOVA_DEFAULT_TENANT_ID=novaenterprise-demo
# Local demo only. Replace with a strong secret outside local/test environments.
NOVA_JWT_SECRET=local-demo-secret-change-before-production-32
NOVA_JWT_ISSUER=novaenterprise
NOVA_JWT_AUDIENCE=novaenterprise-api
NOVA_JWT_TTL_MINUTES=60
NOVA_RATE_LIMIT_PER_MINUTE=120
NOVA_AUDIT_TRAIL_MAX_RECORDS=10000
# Offline defaults; optional real adapters require their SDK, client, and credentials.
NOVA_LLM_PROVIDER=fake
NOVA_LLM_MODEL=fake-v1
NOVA_EMBEDDING_PROVIDER=fake
NOVA_EMBEDDING_MODEL=fake-embedding-v1
NOVA_EMBEDDING_DIMENSION=32
NOVA_VECTOR_STORE=memory
NOVA_QDRANT_URL=http://localhost:6333
NOVA_QDRANT_COLLECTION=novaenterprise-documents
# NOVA_QDRANT_API_KEY=
NOVA_GRAPH_STORE=memory
NOVA_NEO4J_URI=bolt://localhost:7687
NOVA_NEO4J_DATABASE=neo4j
# Set both together when Neo4j authentication is enabled.
# NOVA_NEO4J_USERNAME=neo4j
# NOVA_NEO4J_PASSWORD=
NOVA_CACHE_BACKEND=memory
NOVA_REDIS_URL=redis://localhost:6379/0
NOVA_SESSION_TTL_SECONDS=3600
NOVA_MAX_SUBQUESTIONS=4
NOVA_MAX_CORRECTIVE_ROUNDS=1
